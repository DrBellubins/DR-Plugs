# Save as ".clang-tidy" in the repo root. Run: clang-tidy -p build file.cpp   (add --fix to apply renames/braces)
# Needs compile_commands.json (CMake: -DCMAKE_EXPORT_COMPILE_COMMANDS=ON).
Checks: >
  -*,
  readability-identifier-naming,
  readability-identifier-length,
  readability-braces-around-statements
CheckOptions:
  # Public-visible things: CamelCase
  readability-identifier-naming.NamespaceCase: CamelCase
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.PublicMethodCase: CamelCase
  readability-identifier-naming.ProtectedMethodCase: CamelCase
  readability-identifier-naming.PublicMemberCase: CamelCase
  readability-identifier-naming.ProtectedMemberCase: CamelCase
  readability-identifier-naming.GlobalFunctionCase: CamelCase
  # Private things: camelBack
  readability-identifier-naming.PrivateMethodCase: camelBack
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  # Constants: kCamelCase, public or private
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  # "Never abbreviate": catches too-short names (i, b, p, sl, ch). It cannot detect longer abbreviations.
  readability-identifier-length.MinimumVariableNameLength: 4
  readability-identifier-length.MinimumParameterNameLength: 4
  readability-identifier-length.MinimumLoopCounterNameLength: 4
  readability-identifier-length.IgnoredLoopCounterNames: '^$'
  # Braces only when the body spans 2+ lines
  readability-braces-around-statements.ShortStatementLines: 2
